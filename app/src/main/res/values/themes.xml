<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="appAccent">#FF3D8BFD</item>
        <item name="appAccent0D">#0D3D8BFD</item>
        <item name="appAccent26">#263D8BFD</item>
        <item name="appAccent4D">#4D3D8BFD</item>
        <item name="appAccent59">#593D8BFD</item>
        <item name="appAccent66">#663D8BFD</item>
        <item name="appAccent73">#733D8BFD</item>
        <item name="appAccent80">#803D8BFD</item>
        <item name="appAccent99">#993D8BFD</item>
        <item name="appAccentCC">#CC3D8BFD</item>
        <item name="appGlow">#FF182D4A</item>
        <item name="colorAccent">#FF3D8BFD</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="alertDialogTheme">@style/TvDialog</item>
    </style>

    <!-- Dialog buttons get the same strong focus highlight as the rest of the app (D-pad only). -->
    <style name="TvDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">?attr/appAccent</item>
        <item name="android:windowBackground">@drawable/bg_panel</item>
        <item name="buttonBarPositiveButtonStyle">@style/TvDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TvDialogButton</item>
    </style>

    <style name="TvDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppTheme.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">140dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TvInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
    </style>

    <!-- Player controls: white text with a soft shadow, readable on bright video. -->
    <style name="VcText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#D9000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <style name="VcCircle">
        <item name="android:layout_width">@dimen/vc_button</item>
        <item name="android:layout_height">@dimen/vc_button</item>
        <item name="android:layout_marginLeft">@dimen/vc_gap</item>
        <item name="android:layout_marginRight">@dimen/vc_gap</item>
        <item name="android:background">@drawable/bg_vc_circle</item>
        <item name="android:padding">@dimen/vc_icon_pad</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="VcPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/vc_button</item>
        <item name="android:layout_marginLeft">@dimen/vc_gap</item>
        <item name="android:layout_marginRight">@dimen/vc_gap</item>
        <item name="android:background">@drawable/bg_vc_pill</item>
        <item name="android:paddingLeft">@dimen/vc_pill_pad</item>
        <item name="android:paddingRight">@dimen/vc_pill_pad</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/vc_pill_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Glass screens (playlists, add playlist). -->
    <style name="GlassPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:layout_marginRight">8dp</item>
        <item name="android:minWidth">110dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_glass_pill</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Home H2 side menu row and H4 tab. -->
    <style name="SideMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/bg_glass_item</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <style name="HomeTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_glass_tab</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">26dp</item>
        <item name="android:paddingRight">26dp</item>
    </style>

    <style name="SettingsMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/bg_glass_item</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="GlassInput" parent="TvInput">
        <item name="android:background">@drawable/bg_glass_input</item>
    </style>

    <style name="HomeRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="HomeRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:padding">2dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Home: big tinted glass tiles with an icon, name and count. -->
    <style name="HomeTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginRight">18dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">28dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="HomeTileIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="HomeTileName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeTileCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#FFC8D0DC</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="GlassChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_glass_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
