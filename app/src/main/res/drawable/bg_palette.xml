<?xml version="1.0" encoding="utf-8"?>
<!-- Palette background: the palette's base colour with one soft glow top-left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?attr/appBg" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.22"
                android:centerY="0.12"
                android:endColor="#00000000"
                android:gradientRadius="620dp"
                android:startColor="?attr/appGlow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
