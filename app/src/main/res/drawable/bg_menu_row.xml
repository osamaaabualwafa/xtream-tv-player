<?xml version="1.0" encoding="utf-8"?>
<!-- A choice in a small themed list (the Sort list in Movies/Series): no frame until highlighted,
     then highlighted like every other row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="?attr/appFocusFill" />
                    <stroke android:width="?attr/appFocusStrokeThin" android:color="?attr/appFocusStroke" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <stroke android:width="?attr/appFocusGlowWidth" android:color="?attr/appFocusGlow" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
