<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface_focus" />
            <stroke android:width="3dp" android:color="?attr/appAccent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/surface_active" />
            <stroke android:width="1dp" android:color="?attr/appAccent66" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
