<?xml version="1.0" encoding="utf-8"?>
<!-- Featured banner frame: glass, white border when highlighted. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
            <solid android:color="#14FFFFFF" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner22" />
        </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <stroke android:width="?attr/appFocusGlowWidth" android:color="?attr/appFocusGlow" />
                    <corners android:radius="?attr/appCorner22" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="?attr/appCardStroke" />
            <corners android:radius="?attr/appCorner22" />
        </shape>
    </item>
</selector>
