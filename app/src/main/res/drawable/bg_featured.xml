<?xml version="1.0" encoding="utf-8"?>
<!-- Featured banner frame: glass, white border when highlighted. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#14FFFFFF" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner22" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="?attr/appGlassStroke" />
            <corners android:radius="?attr/appCorner22" />
        </shape>
    </item>
</selector>
