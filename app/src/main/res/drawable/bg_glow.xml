<?xml version="1.0" encoding="utf-8"?>
<!-- Glow: dark, with a soft glow of the theme colour top-left and a fainter one bottom-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#FF0E1218" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.22"
                android:centerY="0.12"
                android:endColor="#000E1218"
                android:gradientRadius="620dp"
                android:startColor="?attr/appGlow"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.88"
                android:centerY="0.95"
                android:endColor="#000E1218"
                android:gradientRadius="520dp"
                android:startColor="?attr/appAccent26"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
