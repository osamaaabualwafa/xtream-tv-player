<?xml version="1.0" encoding="utf-8"?>
<!-- Poster card in the grid: clear glass; focused = blue glass + white border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent59" />
            <stroke android:width="3dp" android:color="@android:color/white" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
