<?xml version="1.0" encoding="utf-8"?>
<!-- Poster card in the grid: clear glass; focused = blue glass + white border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appFocusFill" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner12" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="?attr/appCorner12" />
        </shape>
    </item>
</selector>
