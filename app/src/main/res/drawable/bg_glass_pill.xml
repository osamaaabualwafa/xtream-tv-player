<?xml version="1.0" encoding="utf-8"?>
<!-- Small glass button (Backup, Restore, Edit). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent80" />
            <stroke android:width="?attr/appFocusStrokeThin" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner24" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appGlassFill" />
            <stroke android:width="1dp" android:color="?attr/appGlassStroke" />
            <corners android:radius="?attr/appCorner24" />
        </shape>
    </item>
</selector>
