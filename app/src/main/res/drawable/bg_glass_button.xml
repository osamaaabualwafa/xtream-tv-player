<?xml version="1.0" encoding="utf-8"?>
<!-- Main button on the glass card (Log in). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner10" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appAccentCC" />
            <corners android:radius="?attr/appCorner10" />
        </shape>
    </item>
</selector>
