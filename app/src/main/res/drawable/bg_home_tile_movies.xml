<?xml version="1.0" encoding="utf-8"?>
<!-- Home tile, Movies: pink. Focused: stronger tint and a white border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="315" android:endColor="?attr/appTileFocusMoviesEnd" android:startColor="?attr/appTileFocusMoviesStart" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner22" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:endColor="#0AFFFFFF" android:startColor="?attr/appTile2_38" />
            <stroke android:width="1dp" android:color="?attr/appGlassStroke" />
            <corners android:radius="?attr/appCorner22" />
        </shape>
    </item>
</selector>
