<?xml version="1.0" encoding="utf-8"?>
<!-- Home tile, Movies: pink. Focused: stronger tint and a white border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="315" android:endColor="#1AEC4899" android:startColor="#66EC4899" />
            <stroke android:width="3dp" android:color="@android:color/white" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:endColor="#0AFFFFFF" android:startColor="#38EC4899" />
            <stroke android:width="1dp" android:color="#29FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
