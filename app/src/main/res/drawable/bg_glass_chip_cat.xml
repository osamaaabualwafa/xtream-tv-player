<?xml version="1.0" encoding="utf-8"?>
<!-- B3 category chip: focused = accent glass + white border, chosen = accent outline only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent80" />
            <stroke android:width="?attr/appFocusStrokeThin" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner23" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
            <corners android:radius="?attr/appCorner23" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appGlassFill" />
            <stroke android:width="1dp" android:color="?attr/appGlassStroke" />
            <corners android:radius="?attr/appCorner23" />
        </shape>
    </item>
</selector>
