<?xml version="1.0" encoding="utf-8"?>
<!-- B3 category chip: focused = accent glass + white border, chosen = accent outline only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
            <solid android:color="?attr/appFocusPill" />
            <stroke android:width="?attr/appFocusStrokeThin" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner23" />
        </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <stroke android:width="?attr/appFocusGlowWidth" android:color="?attr/appFocusGlow" />
                    <corners android:radius="?attr/appCorner23" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="?attr/appSelectedChip" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
            <corners android:radius="?attr/appCorner23" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appGlassCard" />
            <stroke android:width="1dp" android:color="?attr/appCardStroke" />
            <corners android:radius="?attr/appCorner23" />
        </shape>
    </item>
</selector>
