<?xml version="1.0" encoding="utf-8"?>
<!-- Emoji choice in the avatar picker: focused = accent glass + white ring, chosen = accent ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="?attr/appAccent80" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="?attr/appAccent26" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/appGlassFill" />
            <stroke android:width="1dp" android:color="?attr/appGlassStroke" />
        </shape>
    </item>
</selector>
