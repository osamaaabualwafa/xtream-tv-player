<?xml version="1.0" encoding="utf-8"?>
<!-- Rows on glass screens (categories, channels): focused = blue glass + white border,
     selected category = faint blue, otherwise clear. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent59" />
            <stroke android:width="2dp" android:color="@android:color/white" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="?attr/appAccent26" />
            <stroke android:width="1dp" android:color="?attr/appAccent66" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0AFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
