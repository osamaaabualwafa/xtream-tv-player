<?xml version="1.0" encoding="utf-8"?>
<!-- H4 tab: clear, focused = accent glass with a white border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
            <solid android:color="?attr/appFocusPill" />
            <stroke android:width="?attr/appFocusStrokeThin" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner26" />
        </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <stroke android:width="?attr/appFocusGlowWidth" android:color="?attr/appFocusGlow" />
                    <corners android:radius="?attr/appCorner26" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="?attr/appCorner26" />
        </shape>
    </item>
</selector>
