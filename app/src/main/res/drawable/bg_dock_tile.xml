<?xml version="1.0" encoding="utf-8"?>
<!-- Dock Home tile: rounded glass square; focused = a ring around it (WinDock's immersive focus). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
                    <corners android:radius="38dp" />
                </shape>
            </item>
            <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
                <shape>
                    <solid android:color="?attr/appFocusFill" />
                    <stroke android:width="1dp" android:color="?attr/appCardStroke" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:bottom="9dp" android:left="9dp" android:right="9dp" android:top="9dp">
        <shape>
            <gradient android:angle="270" android:endColor="#03FFFFFF" android:startColor="#13FFFFFF" />
            <stroke android:width="1dp" android:color="?attr/appGlassStroke" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</selector>
