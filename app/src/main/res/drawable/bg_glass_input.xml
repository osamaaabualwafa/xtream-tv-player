<?xml version="1.0" encoding="utf-8"?>
<!-- Text field on the glass card; the focused one gets a blue outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#263D8BFD" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
