<?xml version="1.0" encoding="utf-8"?>
<!-- Text field on the glass card; the focused one gets a blue outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
            <solid android:color="?attr/appFocusInput" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
            <corners android:radius="?attr/appCorner10" />
        </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <stroke android:width="?attr/appFocusGlowWidth" android:color="?attr/appFocusGlow" />
                    <corners android:radius="?attr/appCorner10" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appChoiceFill" />
            <stroke android:width="1dp" android:color="?attr/appChoiceStroke" />
            <corners android:radius="?attr/appCorner10" />
        </shape>
    </item>
</selector>
