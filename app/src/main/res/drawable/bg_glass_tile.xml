<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist tile: frosted glass; focused = soft blue glass with a white border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent4D" />
            <stroke android:width="3dp" android:color="@android:color/white" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#29FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
