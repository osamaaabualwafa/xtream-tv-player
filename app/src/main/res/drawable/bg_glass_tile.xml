<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist tile: frosted glass; focused = soft blue glass with a white border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent4D" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner28" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appGlassFill" />
            <stroke android:width="1dp" android:color="?attr/appGlassStroke" />
            <corners android:radius="?attr/appCorner28" />
        </shape>
    </item>
</selector>
