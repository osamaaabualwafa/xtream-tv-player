<?xml version="1.0" encoding="utf-8"?>
<!-- Settings picture card: focused = accent glass + white border, chosen = accent border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
            <solid android:color="?attr/appFocusFill" />
            <stroke android:width="?attr/appFocusStrokeThick" android:color="?attr/appFocusStroke" />
            <corners android:radius="?attr/appCorner16" />
        </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <stroke android:width="?attr/appFocusGlowWidth" android:color="?attr/appFocusGlow" />
                    <corners android:radius="?attr/appCorner16" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="?attr/appSelectedFill" />
            <stroke android:width="2dp" android:color="?attr/appSelectedRing" />
            <corners android:radius="?attr/appCorner16" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/appChoiceFill" />
            <stroke android:width="1dp" android:color="?attr/appChoiceStroke" />
            <corners android:radius="?attr/appCorner16" />
        </shape>
    </item>
</selector>
