<?xml version="1.0" encoding="utf-8"?>
<!-- Settings picture card: focused = accent glass + white border, chosen = accent border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/appAccent59" />
            <stroke android:width="3dp" android:color="@android:color/white" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="?attr/appAccent26" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
