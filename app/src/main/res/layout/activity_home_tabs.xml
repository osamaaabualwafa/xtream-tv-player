<?xml version="1.0" encoding="utf-8"?>
<!-- Home H4: glass tab bar at the top (Live TV, Movies, Series, Search), rows below. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="24dp"
        android:paddingRight="48dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xtream TV"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expiry_chip"
                style="@style/GlassChip"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/playlist_chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_glass_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusDown="@id/tile_series"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/playlist_initial"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playlist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_button"
                style="@style/GlassChip"
                android:layout_marginLeft="10dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/tile_series"
                android:text="⚙" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_glass_tabbar"
                android:orientation="horizontal"
                android:padding="6dp">

                <LinearLayout
                    android:id="@+id/tile_live"
                    style="@style/HomeTab">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Live TV"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tile_live_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:singleLine="true"
                        android:textColor="#FFC8D0DC"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_movies"
                    style="@style/HomeTab">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Movies"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tile_movies_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:singleLine="true"
                        android:textColor="#FFC8D0DC"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_series"
                    style="@style/HomeTab">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Series"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tile_series_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:singleLine="true"
                        android:textColor="#FFC8D0DC"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_search"
                    style="@style/HomeTab">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="⌕  Search"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/expiry_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:padding="14dp"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:visibility="gone" />

        <include layout="@layout/view_featured" />

        <TextView
            android:id="@+id/row_new_title"
            style="@style/HomeRowTitle"
            android:text="New episodes" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_new"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_continue_title"
            style="@style/HomeRowTitle"
            android:text="Continue watching" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_continue"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_channels_title"
            style="@style/HomeRowTitle"
            android:text="Favorite channels" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_channels"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_favorites_title"
            style="@style/HomeRowTitle"
            android:text="Favorite movies and series" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_favorites"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_recent_title"
            style="@style/HomeRowTitle"
            android:text="Recently added movies" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_recent"
            style="@style/HomeRow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/refresh_lists"
                style="@style/GlassPill"
                android:text="Refresh lists" />

            <TextView
                android:id="@+id/check_updates"
                style="@style/GlassPill"
                android:text="Check for updates" />
            <TextView
                android:id="@+id/logout"
                style="@style/GlassPill"
                android:layout_marginRight="0dp"
                android:text="Playlists" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
