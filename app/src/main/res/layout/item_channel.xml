<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_glass_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="16dp">

    <TextView
        android:id="@+id/subtitle"
        android:duplicateParentState="true"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/text_secondary_focus"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/image"
        android:layout_width="64dp"
        android:layout_height="44dp"
        android:layout_marginRight="16dp"
        android:scaleType="fitCenter" />

    <!-- Name, then what is on now (with progress) when the provider has a guide. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
        android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:lineSpacingExtra="-2dp"
            android:textColor="@color/text_focus_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/epg_now"
        android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary_focus"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/epg_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_poster"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/fav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★"
        android:textColor="?attr/appGold"
        android:textSize="20sp"
        android:visibility="gone" />
</LinearLayout>
