<?xml version="1.0" encoding="utf-8"?>
<!-- Movie / episode controls: titles top-left, clock top-right, light shade, controls at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vod_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:clipChildren="false"
    android:visibility="gone">

    <View
        android:id="@+id/vc_shade_top"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="top"
        android:background="@drawable/shade_top" />

    <View
        android:id="@+id/vc_shade_bottom"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/shade_bottom" />

    <LinearLayout
        android:id="@+id/vc_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="200dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vc_title"
            style="@style/VcText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vc_episode"
                style="@style/VcText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:singleLine="true"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vc_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass"
                android:paddingLeft="9dp"
                android:paddingTop="2dp"
                android:paddingRight="9dp"
                android:paddingBottom="2dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/vc_clock"
        style="@style/VcText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginRight="40dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/vc_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vc_meta"
                style="@style/VcText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/vc_upnext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_vc_card"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="6dp"
                android:paddingRight="14dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Up next"
                    android:textColor="#FFC9CED6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/vc_upnext_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Timeline: focusable; Left/Right seek with a time bubble above the dot. Pulled up
             under the length / "Ends at" line (the bubble space above the bar overlaps it). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-26dp"
            android:clipChildren="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vc_position"
                style="@style/VcText"
                android:layout_width="80dp"
                android:layout_height="24dp"
                android:layout_marginRight="10dp"
                android:gravity="center_vertical|end"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/vc_timeline"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:focusable="true">

                <View
                    android:id="@+id/vc_track"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="10dp"
                    android:background="#4DFFFFFF" />

                <View
                    android:id="@+id/vc_buffered"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="10dp"
                    android:background="#66FFFFFF" />

                <View
                    android:id="@+id/vc_played"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="10dp"
                    android:background="?attr/appAccent" />

                <View
                    android:id="@+id/vc_thumb"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/vc_dot" />

                <TextView
                    android:id="@+id/vc_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_vc_bubble"
                    android:paddingLeft="10dp"
                    android:paddingTop="2dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />
            </FrameLayout>

            <TextView
                android:id="@+id/vc_remaining"
                style="@style/VcText"
                android:layout_width="80dp"
                android:layout_height="24dp"
                android:layout_marginLeft="10dp"
                android:gravity="center_vertical|start"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Button row, centred. -->
        <FrameLayout
            android:id="@+id/vc_row_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/vc_row"
                android:background="@drawable/bg_vc_row"
                android:padding="@dimen/vc_row_pad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/vc_prev"
                    style="@style/VcCircle"
                    android:contentDescription="Previous episode"
                    android:src="@drawable/ic_vc_prev" />

                <TextView
                    android:id="@+id/vc_back"
                    style="@style/VcPill"
                    android:contentDescription="Back 5 seconds"
                    android:drawableLeft="@drawable/ic_vc_arrow_left"
                    android:text="5s" />

                <ImageView
                    android:id="@+id/vc_play"
                    style="@style/VcCircle"
                    android:layout_width="@dimen/vc_play"
                    android:layout_height="@dimen/vc_play"
                    android:padding="@dimen/vc_play_pad"
                    android:contentDescription="Pause"
                    android:src="@drawable/ic_vc_pause" />

                <TextView
                    android:id="@+id/vc_forward"
                    style="@style/VcPill"
                    android:contentDescription="Forward 10 seconds"
                    android:drawableRight="@drawable/ic_vc_arrow_right"
                    android:text="10s" />

                <ImageView
                    android:id="@+id/vc_next"
                    style="@style/VcCircle"
                    android:contentDescription="Next episode"
                    android:src="@drawable/ic_vc_next" />

                <View
                    android:id="@+id/vc_sep"
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="#4DFFFFFF" />

                <ImageView
                    android:id="@+id/vc_episodes"
                    style="@style/VcCircle"
                    android:contentDescription="Episodes"
                    android:src="@drawable/ic_vc_list" />

                <ImageView
                    android:id="@+id/vc_tracks"
                    style="@style/VcCircle"
                    android:contentDescription="Audio and subtitles"
                    android:src="@drawable/ic_vc_subtitles" />

                <ImageView
                    android:id="@+id/vc_settings"
                    style="@style/VcCircle"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_vc_settings" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
