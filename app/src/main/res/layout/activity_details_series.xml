<?xml version="1.0" encoding="utf-8"?>
<!-- Series page (S3): the series big on top over its picture, then season tabs and one
     scrolling row of episode cards. Same ids as activity_details. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shade_details" />

    <View
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:background="@drawable/shade_bottom" />

    <!-- Kept for the shared code; the backdrop shows the picture here. -->
    <ImageView
        android:id="@+id/poster"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <com.osama.xtreamtv.SeriesColumn
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="44dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <!-- Scrolls when large sizes make it taller than the space above the seasons. -->
        <com.osama.xtreamtv.FocusScrollView
            android:layout_width="match_parent"
            android:layout_marginRight="44dp"
            android:layout_height="wrap_content"
            android:scrollbars="none">

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
        android:tag="screen_title"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/appText"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <!-- 1.1E: the next episode (series), from MDBList. -->
            <TextView
                android:id="@+id/next_episode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_meta_chip"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:textColor="?attr/appText"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="?attr/appTextSecondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/appTextSecondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/play"
                    style="@style/GlassButton"
                    android:layout_marginLeft="0dp"
                    android:background="@drawable/bg_glass_button"
                    android:textColor="@color/on_button"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/resume"
                    style="@style/GlassButton"
                    android:layout_marginLeft="0dp"
                    android:background="@drawable/bg_glass_button"
                    android:textColor="@color/on_button"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/trailer"
                    style="@style/GlassButton"
                    android:text="Trailer"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/favorite"
                    style="@style/GlassButton" />

                <Button
                    android:id="@+id/wrong_scores"
                    style="@style/GlassButton"
                    android:text="Wrong scores"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/appError"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
        </com.osama.xtreamtv.FocusScrollView>

        <!-- Season tabs and the episode row. -->
        <LinearLayout
            android:id="@+id/episodes_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingRight="44dp"
                android:paddingBottom="10dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingRight="44dp"
                android:paddingBottom="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1.1E: More like this, under the episodes; Down from the episodes slides the top part away. -->
        <LinearLayout
            android:id="@+id/recos_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/recos_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="More like this"
                android:textColor="?attr/appText"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:paddingRight="44dp" />
        </LinearLayout>
    </com.osama.xtreamtv.SeriesColumn>
</FrameLayout>
