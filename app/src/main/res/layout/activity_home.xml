<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="28dp"
        android:paddingRight="48dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xtream TV"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/expiry_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:padding="14dp"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tile_live"
                style="@style/HomeTile"
                android:text="Live TV" />

            <TextView
                android:id="@+id/tile_movies"
                style="@style/HomeTile"
                android:text="Movies" />

            <TextView
                android:id="@+id/tile_series"
                style="@style/HomeTile"
                android:text="Series" />

            <TextView
                android:id="@+id/tile_search"
                style="@style/HomeTile"
                android:text="Search" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_continue_title"
            style="@style/HomeRowTitle"
            android:text="Continue watching" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_continue"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_channels_title"
            style="@style/HomeRowTitle"
            android:text="Favorite channels" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_channels"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_favorites_title"
            style="@style/HomeRowTitle"
            android:text="Favorite movies and series" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_favorites"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_recent_title"
            style="@style/HomeRowTitle"
            android:text="Recently added movies" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_recent"
            style="@style/HomeRow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/refresh_lists"
                style="@style/TvButton"
                android:layout_marginRight="12dp"
                android:text="Refresh lists" />

            <Button
                android:id="@+id/check_updates"
                style="@style/TvButton"
                android:layout_marginRight="12dp"
                android:text="Check for updates" />

            <Button
                android:id="@+id/logout"
                style="@style/TvButton"
                android:text="Playlists" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
