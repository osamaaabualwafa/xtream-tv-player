<?xml version="1.0" encoding="utf-8"?>
<!-- Home H1: Continue watching as a big hero at the top, smaller glass tiles, then the rows. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="24dp"
        android:paddingRight="48dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
        android:tag="screen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xtream TV"
                android:textColor="?attr/appText"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expiry_chip"
                style="@style/GlassChip"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/playlist_chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_glass_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusDown="@id/tile_series"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/playlist_initial"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playlist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    android:singleLine="true"
                    android:textColor="?attr/appText"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_button"
                style="@style/GlassChip"
                android:layout_marginLeft="10dp"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@id/tile_series"
                android:text="⚙  Settings" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:textColor="?attr/appText"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/expiry_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:padding="14dp"
            android:textColor="?attr/appGold"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Hero: the last thing watched, with a Resume button (hidden when there is none). -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_card"
            android:visibility="gone">

            <ImageView
                android:id="@+id/hero_image"
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_margin="14dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="230dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue watching"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/appText"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/hero_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="320dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_poster" />

                <TextView
                    android:id="@+id/hero_resume"
                    style="@style/GlassPill"
                    android:layout_marginLeft="0dp"
                    android:layout_marginTop="16dp"
                    android:text="▶  Resume" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_live"
                style="@style/HomeTile"
                android:layout_weight="1"
                android:background="@drawable/bg_home_tile_live">

                <ImageView style="@style/HomeTileIcon" android:src="@drawable/ic_home_live" />

                <TextView style="@style/HomeTileName" android:text="Live TV" />

                <TextView android:id="@+id/tile_live_count" style="@style/HomeTileCount" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_movies"
                style="@style/HomeTile"
                android:layout_weight="1"
                android:background="@drawable/bg_home_tile_movies">

                <ImageView style="@style/HomeTileIcon" android:src="@drawable/ic_home_movies" />

                <TextView style="@style/HomeTileName" android:text="Movies" />

                <TextView android:id="@+id/tile_movies_count" style="@style/HomeTileCount" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_series"
                style="@style/HomeTile"
                android:layout_weight="1"
                android:background="@drawable/bg_home_tile_series">

                <ImageView style="@style/HomeTileIcon" android:src="@drawable/ic_home_series" />

                <TextView style="@style/HomeTileName" android:text="Series" />

                <TextView android:id="@+id/tile_series_count" style="@style/HomeTileCount" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_search"
                style="@style/HomeTile"
                android:layout_weight="1"
                android:layout_marginRight="0dp"
                android:background="@drawable/bg_home_tile_search">

                <ImageView style="@style/HomeTileIcon" android:src="@drawable/ic_home_search" />

                <TextView style="@style/HomeTileName" android:text="Search" />

                <TextView style="@style/HomeTileCount" android:text="Everything" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/row_new_title"
            style="@style/HomeRowTitle"
            android:text="New episodes" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_new"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_continue_title"
            style="@style/HomeRowTitle"
            android:text="Continue watching" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_continue"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_channels_title"
            style="@style/HomeRowTitle"
            android:text="Favorite channels" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_channels"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_favorites_title"
            style="@style/HomeRowTitle"
            android:text="Favorite movies and series" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_favorites"
            style="@style/HomeRow" />

        <TextView
            android:id="@+id/row_recent_title"
            style="@style/HomeRowTitle"
            android:text="Recently added movies" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_recent"
            style="@style/HomeRow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/appTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/refresh_lists"
                style="@style/GlassPill"
                android:text="Refresh lists" />

            <TextView
                android:id="@+id/check_updates"
                style="@style/GlassPill"
                android:text="Check for updates" />
            <TextView
                android:id="@+id/logout"
                style="@style/GlassPill"
                android:layout_marginRight="0dp"
                android:text="Playlists" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
