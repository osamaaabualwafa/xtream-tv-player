<?xml version="1.0" encoding="utf-8"?>
<!-- Player: resume or start over (glass card). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/resume_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resume_where"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/resume_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:progressDrawable="@drawable/progress_poster" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/resume_go"
            style="@style/GlassButton"
            android:layout_marginLeft="0dp"
            android:background="@drawable/bg_glass_button" />

        <Button
            android:id="@+id/resume_restart"
            style="@style/GlassButton"
            android:text="↺  Start over" />
    </LinearLayout>
</LinearLayout>
