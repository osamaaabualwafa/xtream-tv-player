<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_buffering="never" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="48dp"
        android:background="@drawable/bg_panel"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="24dp"
        android:textColor="?attr/appText"
        android:textSize="18sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="top"
            android:background="@drawable/shade_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="bottom"
            android:background="@drawable/shade_bottom" />

        <TextView
            android:id="@+id/overlay_clock"
            style="@style/VcText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="28dp"
            android:layout_marginRight="40dp"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/overlay_logo"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_glass"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/overlay_name"
                        style="@style/VcText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/overlay_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass"
                        android:paddingLeft="9dp"
                        android:paddingTop="2dp"
                        android:paddingRight="9dp"
                        android:paddingBottom="2dp"
                        android:textColor="?attr/appText"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/overlay_now"
                    style="@style/VcText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="17sp" />

                <ProgressBar
                    android:id="@+id/overlay_progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp"
                    android:max="1000"
                    android:progressBackgroundTint="#4DFFFFFF"
                    android:progressTint="?attr/appAccent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/overlay_next"
                    style="@style/VcText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFE3E6EA"
                    android:textSize="15sp" />

                <TextView
                    style="@style/VcText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="◀  Channels     ▲ ▼  Change channel     ▶  Options     0–9  Channel number"
                    android:textColor="#FFC9CED6"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Live: channel list slides in from the left. -->
    <LinearLayout
        android:id="@+id/channels_panel"
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/appOverlay"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="28dp"
        android:paddingRight="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/channels_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textColor="?attr/appText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channels_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- Episodes: "Skip intro" / "Next episode in 20s" prompt; OK triggers it. -->
    <LinearLayout
        android:id="@+id/action_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:textColor="?attr/appText"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button"
            android:duplicateParentState="false"
            android:paddingLeft="18dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:textColor="?attr/appText"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live: channel number being typed on the remote. -->
    <TextView
        android:id="@+id/number_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="40dp"
        android:background="@drawable/bg_panel"
        android:minWidth="140dp"
        android:gravity="center"
        android:paddingLeft="28dp"
        android:paddingTop="10dp"
        android:paddingRight="28dp"
        android:paddingBottom="10dp"
        android:textColor="?attr/appText"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Remote play/pause feedback. -->
    <TextView
        android:id="@+id/play_flash"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_play_flash"
        android:gravity="center"
        android:textColor="?attr/appText"
        android:textSize="40sp"
        android:visibility="gone" />

    <!-- Quick seek feedback: a rounded tab on the right edge (forward) or left edge (back). -->
    <LinearLayout
        android:id="@+id/seek_forward"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_seek_tab_right"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="»"
            android:textColor="?attr/appText"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seek_forward_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/appText"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seek_forward_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFC9CED6"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/seek_back"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/bg_seek_tab_left"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingRight="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="«"
            android:textColor="?attr/appText"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seek_back_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/appText"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seek_back_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFC9CED6"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Movies/episodes: the new controls (titles, clock, timeline, buttons). -->
    <include layout="@layout/view_vod_controls" />

    <!-- Episodes (Settings > Player > Episodes list): glass side panel or bottom shelf;
         size and position are set in code. -->
    <LinearLayout
        android:id="@+id/episodes_panel"
        android:layout_width="600dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_glass_dialog"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episodes"
                android:textColor="?attr/appText"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/episodes_series"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="?attr/appTextSecondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Season chips (hidden for a single season). -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodes_seasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <!-- Settings / options menu (Settings > Player > Player menu): small pop-up or side panel. -->
    <LinearLayout
        android:id="@+id/player_menu"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_glass_dialog"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/appText"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/player_menu_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
