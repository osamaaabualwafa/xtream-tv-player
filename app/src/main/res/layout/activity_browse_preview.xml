<?xml version="1.0" encoding="utf-8"?>
<!-- Browse B4: the focused title shown big at the top (picture, rating, year, genre, plot),
     one row of posters below; the category list opens on the left and pushes them right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- Folded category list: focus it (Left from the first poster) to open the list. -->
    <LinearLayout
        android:id="@+id/category_rail"
        android:layout_width="56dp"
        android:visibility="gone"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_rail"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="?attr/appText"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="‹"
            android:textColor="?attr/appTextSecondary"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Category list: open = posters move right; folded = only the rail, posters use the full width. -->
    <LinearLayout
        android:id="@+id/category_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="16dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp">

        <TextView
        android:tag="screen_title"
            android:id="@+id/type_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingLeft="8dp"
            android:textColor="?attr/appText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/category_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="?attr/appText"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_guide"
                style="@style/GlassPill"
                android:layout_height="46dp"
                android:text="TV guide"
                android:visibility="gone" />

            <EditText
                android:id="@+id/search"
                style="@style/GlassInput"
                android:layout_width="220dp"
                android:layout_height="46dp"
                android:hint="⌕  Search"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text" />
        </LinearLayout>

        <!-- Preview of the focused item. -->
        <FrameLayout
            android:id="@+id/info_strip"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:visibility="invisible">

            <ImageView
                android:id="@+id/preview_image"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_margin="12dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="190dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/info_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="?attr/appText"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/info_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:singleLine="true"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/info_plot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="258dp"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/items"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="10dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="?attr/appTextSecondary"
                android:textSize="17sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>


</LinearLayout>
