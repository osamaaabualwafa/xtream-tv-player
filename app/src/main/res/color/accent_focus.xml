<?xml version="1.0" encoding="utf-8"?>
<!-- Setting value: accent colour, bright while the row is highlighted (accent on accent is unreadable). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/appFocusText" android:state_focused="true" />
    <item android:color="?attr/appAccent" />
</selector>
